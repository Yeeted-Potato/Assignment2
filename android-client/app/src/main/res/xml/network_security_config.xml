<?xml version="1.0" encoding="utf-8"?>
<!--
  The course backend runs on plain HTTP on the development machine. Cleartext
  is permitted for that host only, and stays blocked for every other host, so
  a real deployment can be moved to HTTPS without weakening the app.

  10.0.2.2  - the Android emulator's alias for the host machine's localhost
  10.0.3.2  - the Genymotion emulator's equivalent alias
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
