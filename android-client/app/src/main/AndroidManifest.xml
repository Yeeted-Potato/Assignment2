<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Week 9: the app makes real HTTP calls to the REST API. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Week 9: coarse FOREGROUND location only. No background location is
         requested or needed for the delivery-location workflow. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Location is the optional mobile capability with a manual fallback, so
         the app must still install and run on devices without any location
         hardware. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CustomerOrders">

        <!-- Screen 1: customer sign in. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: the signed in customer's orders. -->
        <activity
            android:name=".OrderListActivity"
            android:exported="false" />

        <!-- Screen 3: place an order with a delivery location. -->
        <activity
            android:name=".CreateOrderActivity"
            android:exported="false" />
    </application>

</manifest>
