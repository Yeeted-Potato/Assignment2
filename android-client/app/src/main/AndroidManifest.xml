<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the app calls the api over http -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- coarse foreground location only, no background location -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- the app must still run on devices with no location hardware -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CustomerOrders">

        <!-- screen 1: sign in -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- screen 2: the customer's orders -->
        <activity
            android:name=".OrderListActivity"
            android:exported="false" />

        <!-- screen 3: place an order -->
        <activity
            android:name=".CreateOrderActivity"
            android:exported="false" />
    </application>

</manifest>
