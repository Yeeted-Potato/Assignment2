# Copy this file to .env and change the values before starting the system:
#
#     copy .env.example .env      (PowerShell)
#     cp .env.example .env        (bash)
#
# .env is ignored by git and holds the local development credentials. Nothing
# in it is a production secret. See README.md under "Configuration".

# RabbitMQ account used by the broker and by every service that publishes or
# consumes order events. Use letters, digits and hyphens only: the password is
# placed inside an amqp:// URL, so reserved URL characters would break it.
RABBITMQ_USER=orders
RABBITMQ_PASSWORD=CHANGE_ME

# Hostname of the broker. Leave as localhost for a local RabbitMQ install;
# Docker Compose overrides this to the rabbitmq service name.
RABBITMQ_HOST=localhost

# Shared secret on the internal service-to-service endpoints. Change this if
# the services are ever reachable from another machine.
INTERNAL_EVENT_TOKEN=local-development-token

# Demo staff login password. This is the password of the seeded test account
# described in README.md, so keep it in step with the demo accounts table.
STAFF_PASSWORD=dummypw
